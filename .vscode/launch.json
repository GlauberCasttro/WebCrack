{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WebCrack Flask Debug (5001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PORT": "5001",
        "FLASK_DEBUG": "1",
        "WEBCRACK_OPEN_BROWSER": "0",
        "PYTHONUNBUFFERED": "1"
      },
      "args": [],
      "jinja": true,
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "Pipeline (test_pipeline.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_pipeline.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    }
  ]
}
